{
  "name": "PAndG_Scenarios",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "defaultMode": "import",
    "tables": [
      {
        "name": "Vintage",
        "columns": [
          {
            "name": "Vintage",
            "dataType": "string",
            "sourceColumn": "[Vintage]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "VintageLabel",
            "dataType": "string",
            "sourceColumn": "[VintageLabel]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "sortByColumn": "Sort"
          },
          {
            "name": "Sort",
            "dataType": "int64",
            "sourceColumn": "[Sort]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "partitions": [
          {
            "name": "Vintage",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DATATABLE(\"Vintage\",STRING,\"VintageLabel\",STRING,\"Sort\",INTEGER,{{\"pre_history\",\"March | History only\",1},{\"pre_market\",\"March | Market informed\",2},{\"mid_history\",\"May | History only\",3},{\"mid_market\",\"May | Market informed\",4}})"
            }
          }
        ]
      },
      {
        "name": "VintageCompare",
        "columns": [
          {
            "name": "Vintage",
            "dataType": "string",
            "sourceColumn": "[Vintage]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "VintageLabel",
            "dataType": "string",
            "sourceColumn": "[VintageLabel]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "sortByColumn": "Sort"
          },
          {
            "name": "Sort",
            "dataType": "int64",
            "sourceColumn": "[Sort]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "CompactLabel",
            "dataType": "string",
            "type": "calculated",
            "expression": "SWITCH(VintageCompare[Vintage],\"pre_history\",\"Mar hist\",\"pre_market\",\"Mar res.\",\"mid_history\",\"May hist\",\"mid_market\",\"May res.\")",
            "sortByColumn": "Sort"
          }
        ],
        "partitions": [
          {
            "name": "VintageCompare",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DATATABLE(\"Vintage\",STRING,\"VintageLabel\",STRING,\"Sort\",INTEGER,{{\"pre_history\",\"March | History only\",1},{\"pre_market\",\"March | Market informed\",2},{\"mid_history\",\"May | History only\",3},{\"mid_market\",\"May | Market informed\",4}})"
            }
          }
        ]
      },
      {
