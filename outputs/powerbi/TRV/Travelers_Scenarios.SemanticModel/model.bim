            "sortByColumn": "Sort"
          },
          {
            "name": "Sort",
            "dataType": "int64",
            "sourceColumn": "[Sort]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "partitions": [
          {
            "name": "Scenario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DATATABLE(\"Case\",STRING,\"Sort\",INTEGER,{{\"bear\",1},{\"base\",2},{\"bull\",3}})"
            }
          }
        ]
      },
      {
        "name": "Forecast",
        "columns": [
          {
            "name": "Vintage",
            "dataType": "string",
            "sourceColumn": "[Vintage]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Case",
            "dataType": "string",
            "sourceColumn": "[Case]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Revenue",
            "dataType": "double",
            "sourceColumn": "[Revenue]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Profit",
            "dataType": "double",
            "sourceColumn": "[Profit]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Operating",
            "dataType": "double",
            "sourceColumn": "[Operating]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Margin",
            "dataType": "double",
            "sourceColumn": "[Margin]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "formatString": "0.0%"
          },
          {
            "name": "Liquidity",
            "dataType": "double",
            "sourceColumn": "[Liquidity]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          }
        ],
        "partitions": [
          {
            "name": "Forecast",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "DATATABLE(\"Vintage\",STRING,\"Case\",STRING,\"Revenue\",DOUBLE,\"Profit\",DOUBLE,\"Operating\",DOUBLE,\"Margin\",DOUBLE,\"Liquidity\",DOUBLE,{{\"pre_history\",\"bear\",10921.0,271.9134599999998,-476.39300000000026,1.0402417361047522,1800},{\"pre_history\",\"base\",11248.630000000001,1620.3478433999999,1037.8678000000002,0.9044522933014953,1000},{\"pre_history\",\"bull\",11576.26,2449.1873160000005,1921.8138000000006,0.8307979606539591,500},{\"pre_market\",\"bear\",10921.0,186.72965999999977,-585.6030000000003,1.0502417361047522,1800},{\"pre_market\",\"base\",11248.630000000001,1620.3478433999999,1037.8678000000002,0.9044522933014953,1000},{\"pre_market\",\"bull\",11576.26,2449.1873160000005,1921.8138000000006,0.8307979606539591,500},{\"mid_history\",\"bear\",10484.16,182.63709799999972,-578.8138000000004,1.051687574397949,1800},{\"mid_history\",\"base\",10811.789999999999,1435.5016956,863.23192,0.9167441357998999,1000},{\"mid_history\",\"bull\",11139.42,2264.094866,1726.0913000000003,0.8417328460548215,500},{\"mid_market\",\"bear\",10484.16,99.81223399999975,-683.6554000000003,1.0616875743979488,1800},{\"mid_market\",\"base\",10811.789999999999,1435.5016956,863.23192,0.9167441357998999,1000},{\"mid_market\",\"bull\",11139.42,2264.094866,1726.0913000000003,0.8417328460548215,500}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Selected Revenue",
            "expression": "VAR V=SELECTEDVALUE(Vintage[Vintage],\"mid_market\") VAR C=SELECTEDVALUE(Scenario[Case],\"base\") RETURN CALCULATE(MAX(Forecast[Revenue]),KEEPFILTERS(Vintage[Vintage]=V),KEEPFILTERS(Scenario[Case]=C))",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Actual Revenue",
            "expression": "MAX(Actual[Revenue])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Selected Profit",
            "expression": "VAR V=SELECTEDVALUE(Vintage[Vintage],\"mid_market\") VAR C=SELECTEDVALUE(Scenario[Case],\"base\") RETURN CALCULATE(MAX(Forecast[Profit]),KEEPFILTERS(Vintage[Vintage]=V),KEEPFILTERS(Scenario[Case]=C))",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Actual Profit",
            "expression": "MAX(Actual[Profit])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Selected Operating",
            "expression": "VAR V=SELECTEDVALUE(Vintage[Vintage],\"mid_market\") VAR C=SELECTEDVALUE(Scenario[Case],\"base\") RETURN CALCULATE(MAX(Forecast[Operating]),KEEPFILTERS(Vintage[Vintage]=V),KEEPFILTERS(Scenario[Case]=C))",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Actual Operating",
            "expression": "MAX(Actual[Operating])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Selected Margin",
            "expression": "VAR V=SELECTEDVALUE(Vintage[Vintage],\"mid_market\") VAR C=SELECTEDVALUE(Scenario[Case],\"base\") RETURN CALCULATE(MAX(Forecast[Margin]),KEEPFILTERS(Vintage[Vintage]=V),KEEPFILTERS(Scenario[Case]=C))",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Actual Margin",
            "expression": "MAX(Actual[Margin])",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Selected Liquidity",
            "expression": "VAR V=SELECTEDVALUE(Vintage[Vintage],\"mid_market\") VAR C=SELECTEDVALUE(Scenario[Case],\"base\") RETURN CALCULATE(MAX(Forecast[Liquidity]),KEEPFILTERS(Vintage[Vintage]=V),KEEPFILTERS(Scenario[Case]=C))",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Vintage profit",
            "expression": "CALCULATE([Selected Profit],REMOVEFILTERS(Vintage),TREATAS(VALUES(VintageCompare[Vintage]),Vintage[Vintage]))",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Profit error",
            "expression": "[Actual Profit]-[Selected Profit]",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Profit error %",
            "expression": "DIVIDE([Profit error],[Selected Profit])",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "History revenue",
            "expression": "SUM(History[Revenue])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "History profit",
            "expression": "SUM(History[Profit])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "History operating",
            "expression": "SUM(History[Operating])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "History cash flow",
            "expression": "SUM(History[CashFlow])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "History ratio",
            "expression": "AVERAGE(History[Ratio])",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Segment value",
            "expression": "SUM(Segments[Amount])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Bridge impact",
            "expression": "CALCULATE(SUM(Bridge[ProfitChange]),KEEPFILTERS(Bridge[Window]=SELECTEDVALUE(Bridge[Window],\"mid\")))",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Actual bridge impact",
            "expression": "SUM(ActualBridge[ProfitChange])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Sensitivity impact",
            "expression": "SUM(Sensitivity[ProfitChange])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Forecast comparison",
            "expression": "SUM(Comparison[Forecast])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Actual comparison",
            "expression": "SUM(Comparison[Actual])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Difference comparison",
            "expression": "SUM(Comparison[Difference])",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "QA rows",
            "expression": "COUNTROWS(QA)",
            "formatString": "0"
          },
          {
            "name": "Catastrophe losses",
            "expression": "[Selected Liquidity]",
            "formatString": "$#,0.0\"M\";($#,0.0\"M\");$0.0\"M\""
          },
          {
            "name": "Profit variance color",
            "expression": "IF([Profit error]>=0,\"#168269\",\"#C8102E\")",
            "formatString": ""
          }
        ]
      },
